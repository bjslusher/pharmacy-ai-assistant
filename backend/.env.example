# LLM Provider: ollama (local). OpenAI optional — not required for this project.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Small/fast chat model — enough for RAG over seed docs (not world knowledge)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Generation caps (speed)
OLLAMA_NUM_PREDICT=350
OLLAMA_NUM_CTX=2048

# Retrieval depth (small corpus → low k is fine)
RAG_TOP_K=3

# Optional cloud (disabled by default for this assessment path)
OPENAI_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Mem0 (optional)
MEM0_API_KEY=
MEM0_USER_ID=pharmacy-assistant-user

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pharmacy-ai-assistant

CHROMA_PATH=./chroma_db
DATA_PATH=./source_data
